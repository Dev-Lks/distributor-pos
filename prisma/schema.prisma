// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPERVISOR
  CASHIER
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(CASHIER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id        String @id @default(cuid())
  name      String
  size      String
  cost      Float
  salePrice Float
  isBonified Boolean @default(false)
  bonifications Int @default(0) // Número de bonificações disponíveis
  category  String? // Ex.: "Cerveja", "Vinho"
  supplier  String? // Fornecedor
  isActive  Boolean @default(true) // Para desativar produtos sem deletar
  sku       String? @unique // Código único para identificação
  brand     String?
  origin    String?
  packaging String?
  abv       Float?
  ibu       Float?
  shelfLifeDays Int?
  tags      String[] @default([])
  lastPurchaseCost Float?
  lastPurchaseAt DateTime?
  avgCost   Float?
  priceLastUpdatedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory Inventory?
  productPointsOfSale ProductPointOfSale[]
  saleItems SaleItem[]
  priceHistories ProductPriceHistory[]
  inventoryMovements InventoryMovement[]
}

model Inventory {
  id        String @id @default(cuid())
  productId String @unique
  // Quantidades por local
  coldRoomQuantity Int @default(0) // Câmara fria
  houseQuantity     Int @default(0) // Casa
  salePointQuantity Int @default(0) // Pontos de venda
  // Estoque mínimo por local
  coldRoomMinStock  Int @default(10)
  houseMinStock     Int @default(5)
  salePointMinStock Int @default(2)
  reservedQuantity  Int @default(0)
  damagedQuantity   Int @default(0)
  inTransitQuantity Int @default(0)
  safetyStock       Int?
  reorderLeadTimeDays Int?
  lastRestockedAt   DateTime?
  lastAuditedAt     DateTime?
  averageDailyConsumption Float?
  turnoverDays      Float?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductPointOfSale {
  id            String @id @default(cuid())
  productId     String
  pointOfSaleId String
  quantity      Int @default(0)
  minStock      Int @default(2)
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  pointOfSale   PointOfSale @relation(fields: [pointOfSaleId], references: [id], onDelete: Cascade)

  @@unique([productId, pointOfSaleId])
  @@index([productId])
  @@index([pointOfSaleId])
}

model Sale {
  id        String @id @default(cuid())
  date      DateTime @default(now())
  total     Float
  status    String @default("completed") // 'pending', 'completed', 'cancelled'
  paymentMethod String?
  customerName String?
  customerEmail String?
  customerPhone String?
  customerDocument String?
  customerAddress String?
  customerId String?
  channel   String?
  subtotal  Float?
  discountValue Float @default(0)
  taxValue  Float @default(0)
  serviceCharge Float @default(0)
  costOfGoods Float @default(0)
  grossMargin Float @default(0)
  pointOfSaleId String?
  notes     String?
  items     SaleItem[]
  payments  SalePayment[]
  pointOfSale PointOfSale? @relation(fields: [pointOfSaleId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  inventoryMovements InventoryMovement[]

  @@index([customerId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?  @unique
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[]
}

model SaleItem {
  id        String @id @default(cuid())
  saleId    String
  productId String
  quantity  Int
  price     Float
  unitCost  Float?
  discount  Float? @default(0)
  sale      Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@unique([saleId, productId])
  @@index([productId])
}

model PointOfSale {
  id        String @id @default(cuid())
  name      String @unique
  isActive  Boolean @default(true)
  code      String? @unique
  channel   String?
  managerName String?
  address   String?
  city      String?
  state     String?
  country   String?
  timezone  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productPointsOfSale ProductPointOfSale[]
  sales     Sale[]
  inventoryMovements InventoryMovement[]
}

model SalePayment {
  id        String @id @default(cuid())
  saleId    String
  method    String
  amount    Float
  receivedAt DateTime?
  reference String?
  notes     String?
  sale      Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

model ProductPriceHistory {
  id        String @id @default(cuid())
  productId String
  cost      Float
  salePrice Float
  effectiveAt DateTime @default(now())
  source    String?
  notes     String?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, effectiveAt])
}

model InventoryMovement {
  id        String @id @default(cuid())
  productId String
  saleId    String?
  pointOfSaleId String?
  type      InventoryMovementType
  quantity  Int
  unitCost  Float?
  fromLocation InventoryLocation?
  toLocation   InventoryLocation?
  adjustmentReason String?
  notes     String?
  performedBy String?
  occurredAt DateTime @default(now())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sale      Sale? @relation(fields: [saleId], references: [id])
  pointOfSale PointOfSale? @relation(fields: [pointOfSaleId], references: [id])

  @@index([productId, occurredAt])
  @@index([saleId])
  @@index([pointOfSaleId])
}

enum InventoryMovementType {
  RECEIPT
  TRANSFER
  SALE
  ADJUSTMENT
  LOSS
  RETURN
}

enum InventoryLocation {
  COLD_ROOM
  HOUSE
  SALE_POINT
  SUPPLIER
  TRANSIT
  EVENT
}
