// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPERVISOR
  CASHIER
}

enum PersonType {
  INDIVIDUAL
  COMPANY
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PendingCartStatus {
  ACTIVE
  CONVERTED
  CANCELLED
  EXPIRED
}

enum DailyReportStatus {
  PENDING
  GENERATED
  SENT
  RESENT
  FAILED
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(CASHIER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cashSessions CashSession[]
  cashTransactions CashTransaction[] @relation("UserCashTransactions")
  pendingCarts PendingCart[] @relation("UserPendingCarts")
}

model Product {
  id        String @id @default(cuid())
  name      String
  size      String
  cost      Float
  salePrice Float
  isBonified Boolean @default(false)
  bonifications Int @default(0) // Número de bonificações disponíveis
  category  String? // Ex.: "Cerveja", "Vinho"
  supplier  String? // Fornecedor
  isActive  Boolean @default(true) // Para desativar produtos sem deletar
  sku       String? @unique // Código único para identificação
  brand     String?
  origin    String?
  packaging String?
  abv       Float?
  ibu       Float?
  shelfLifeDays Int?
  tags      String[] @default([])
  lastPurchaseCost Float?
  lastPurchaseAt DateTime?
  avgCost   Float?
  priceLastUpdatedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory Inventory?
  productPointsOfSale ProductPointOfSale[]
  saleItems SaleItem[]
  priceHistories ProductPriceHistory[]
  inventoryMovements InventoryMovement[]
  pendingCartItems PendingCartItem[]
}

model Inventory {
  id        String @id @default(cuid())
  productId String @unique
  // Quantidades por local
  coldRoomQuantity Int @default(0) // Câmara fria
  houseQuantity     Int @default(0) // Casa
  salePointQuantity Int @default(0) // Pontos de venda
  // Estoque mínimo por local
  coldRoomMinStock  Int @default(10)
  houseMinStock     Int @default(5)
  salePointMinStock Int @default(2)
  reservedQuantity  Int @default(0)
  damagedQuantity   Int @default(0)
  inTransitQuantity Int @default(0)
  safetyStock       Int?
  reorderLeadTimeDays Int?
  lastRestockedAt   DateTime?
  lastAuditedAt     DateTime?
  averageDailyConsumption Float?
  turnoverDays      Float?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductPointOfSale {
  id            String @id @default(cuid())
  productId     String
  pointOfSaleId String
  quantity      Int @default(0)
  minStock      Int @default(2)
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  pointOfSale   PointOfSale @relation(fields: [pointOfSaleId], references: [id], onDelete: Cascade)

  @@unique([productId, pointOfSaleId])
  @@index([productId])
  @@index([pointOfSaleId])
}

model Sale {
  id        String @id @default(cuid())
  date      DateTime @default(now())
  total     Float
  status    String @default("completed") // 'pending', 'completed', 'cancelled'
  paymentMethod String?
  customerName String?
  customerEmail String?
  customerPhone String?
  customerDocument String?
  customerAddress String?
  customerId String?
  channel   String?
  subtotal  Float?
  discountValue Float @default(0)
  taxValue  Float @default(0)
  serviceCharge Float @default(0)
  costOfGoods Float @default(0)
  grossMargin Float @default(0)
  pointOfSaleId String?
  cashSessionId String?
  notes     String?
  pendingCartId String? @unique
  metadata Json?
  items     SaleItem[]
  payments  SalePayment[]
  pointOfSale PointOfSale? @relation(fields: [pointOfSaleId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  cashSession CashSession? @relation(fields: [cashSessionId], references: [id])
  pendingCart PendingCart? @relation("SalePendingCart", fields: [pendingCartId], references: [id])
  inventoryMovements InventoryMovement[]

  @@index([customerId])
  @@index([cashSessionId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  type      PersonType @default(INDIVIDUAL)
  document  String?  @unique
  phone     String?  @unique
  secondaryPhone String?
  email     String?
  whatsapp  String?
  address   String?
  addressNumber String?
  addressComplement String?
  district  String?
  city      String?
  state     String?
  postalCode String?
  country   String?
  preferredPaymentMethod String?
  paymentTerms String?
  creditLimit Float?
  creditUsed Float @default(0)
  isBlocked Boolean @default(false)
  blockedReason String?
  notes     String?
  tags      String[] @default([])
  birthDate DateTime?
  isActive  Boolean @default(true)
  isDelinquent Boolean @default(false)
  lastPurchaseAt DateTime?
  averageTicket Float?
  totalSpend Float @default(0)
  totalOrders Int @default(0)
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[]
  pendingCarts PendingCart[]
  payments SalePayment[]
}

model SaleItem {
  id        String @id @default(cuid())
  saleId    String
  productId String
  quantity  Int
  price     Float
  unitCost  Float?
  discount  Float? @default(0)
  sale      Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@unique([saleId, productId])
  @@index([productId])
}

model PointOfSale {
  id        String @id @default(cuid())
  name      String @unique
  isActive  Boolean @default(true)
  code      String? @unique
  channel   String?
  managerName String?
  address   String?
  city      String?
  state     String?
  country   String?
  timezone  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productPointsOfSale ProductPointOfSale[]
  sales     Sale[]
  inventoryMovements InventoryMovement[]
  cashSessions CashSession[]
  pendingCarts PendingCart[]
  dailyReports DailyReport[]
}

model SalePayment {
  id        String @id @default(cuid())
  saleId    String
  method    String
  amount    Float
  dueDate   DateTime?
  status    PaymentStatus @default(PENDING)
  receivedAt DateTime?
  paidAmount Float @default(0)
  reference String?
  notes     String?
  cashSessionId String?
  installmentNumber Int?
  installmentsTotal Int?
  customerId String?
  overdueNotifiedAt DateTime?
  externalReference String?
  metadata Json?
  sale      Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  cashSession CashSession? @relation(fields: [cashSessionId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([saleId])
  @@index([cashSessionId])
  @@index([customerId, status])
}

model ProductPriceHistory {
  id        String @id @default(cuid())
  productId String
  cost      Float
  salePrice Float
  effectiveAt DateTime @default(now())
  source    String?
  notes     String?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, effectiveAt])
}

model PendingCart {
  id             String            @id @default(cuid())
  status         PendingCartStatus @default(ACTIVE)
  pointOfSaleId  String?
  createdById    String
  customerId     String?
  expiresAt      DateTime?
  resumedAt      DateTime?
  discountValue  Float @default(0)
  serviceCharge  Float @default(0)
  subtotal       Float @default(0)
  total          Float @default(0)
  notes          String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  pointOfSale    PointOfSale? @relation(fields: [pointOfSaleId], references: [id])
  createdBy      User @relation("UserPendingCarts", fields: [createdById], references: [id])
  customer       Customer? @relation(fields: [customerId], references: [id])
  sale           Sale? @relation("SalePendingCart")
  items          PendingCartItem[]

  @@index([pointOfSaleId, status])
  @@index([customerId])
  @@index([createdById])
}

model PendingCartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  price     Float
  discount  Float @default(0)
  notes     String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      PendingCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([cartId])
  @@index([productId])
}

model DailyReport {
  id                 String            @id @default(cuid())
  reportDate         DateTime
  periodStart        DateTime
  periodEnd          DateTime
  status             DailyReportStatus @default(PENDING)
  pointOfSaleId      String?
  cashSessionId      String?
  totalsByMethod     Json
  subtotal           Float @default(0)
  discountTotal      Float @default(0)
  taxTotal           Float @default(0)
  serviceChargeTotal Float @default(0)
  grossTotal         Float @default(0)
  netTotal           Float @default(0)
  fileUrl            String?
  fileType           String?
  storageKey         String?
  sentAt             DateTime?
  resentCount        Int @default(0)
  lastResentAt       DateTime?
  deliveryMetadata   Json?
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  pointOfSale        PointOfSale? @relation(fields: [pointOfSaleId], references: [id])
  cashSession        CashSession? @relation(fields: [cashSessionId], references: [id])

  @@unique([reportDate, pointOfSaleId])
  @@index([cashSessionId])
  @@index([status])
}

model InventoryMovement {
  id        String @id @default(cuid())
  productId String
  saleId    String?
  pointOfSaleId String?
  type      InventoryMovementType
  quantity  Int
  unitCost  Float?
  fromLocation InventoryLocation?
  toLocation   InventoryLocation?
  adjustmentReason String?
  notes     String?
  performedBy String?
  occurredAt DateTime @default(now())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sale      Sale? @relation(fields: [saleId], references: [id])
  pointOfSale PointOfSale? @relation(fields: [pointOfSaleId], references: [id])

  @@index([productId, occurredAt])
  @@index([saleId])
  @@index([pointOfSaleId])
}

enum InventoryMovementType {
  RECEIPT
  TRANSFER
  SALE
  ADJUSTMENT
  LOSS
  RETURN
}

enum InventoryLocation {
  COLD_ROOM
  HOUSE
  SALE_POINT
  SUPPLIER
  TRANSIT
  EVENT
}

enum CashSessionStatus {
  OPEN
  CLOSING
  CLOSED
}

enum CashTransactionType {
  OPENING
  SUPPLY
  WITHDRAWAL
  ADJUSTMENT
}

model CashSession {
  id                     String             @id @default(cuid())
  userId                 String
  pointOfSaleId          String?
  openedAt               DateTime           @default(now())
  closedAt               DateTime?
  openingAmount          Float              @default(0)
  closingAmount          Float?
  expectedClosingAmount  Float?
  differenceAmount       Float?
  status                 CashSessionStatus  @default(OPEN)
  notes                  String?
  hardwareEventReference String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointOfSale            PointOfSale?       @relation(fields: [pointOfSaleId], references: [id])
  transactions           CashTransaction[]
  sales                  Sale[]
  payments               SalePayment[]
  dailyReports           DailyReport[]

  @@index([userId, status])
  @@index([pointOfSaleId, status])
}

model CashTransaction {
  id                     String              @id @default(cuid())
  cashSessionId          String
  type                   CashTransactionType
  amount                 Float
  description            String?
  performedById          String?
  paymentMethod          String?
  hardwareEventReference String?
  createdAt              DateTime            @default(now())
  notes                  String?
  cashSession            CashSession         @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  performedBy            User?               @relation("UserCashTransactions", fields: [performedById], references: [id])

  @@index([cashSessionId])
  @@index([performedById])
}
