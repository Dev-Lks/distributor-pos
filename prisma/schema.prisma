// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id    String @id @default(cuid())
  name  String
  size  String
  price Decimal @db.Decimal(10, 2)

  // Relations
  stockLevels     StockLevel[]
  stockMovements  StockMovement[]
  inventoryAlerts InventoryAlert[]
  saleItems       SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StockLevel {
  id         String   @id @default(cuid())
  productId  String
  location   Location
  quantity   Int
  minStock   Int
  lastUpdated DateTime @default(now())

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, location])
  @@map("stock_levels")
}

model StockMovement {
  id          String      @id @default(cuid())
  productId   String
  fromLocation Location?
  toLocation   Location?
  quantity    Int
  type        MovementType
  timestamp   DateTime    @default(now())
  notes       String?
  user        String?

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stock_movements")
}

model InventoryAlert {
  id        String     @id @default(cuid())
  productId String
  location  Location
  type      AlertType
  message   String
  timestamp DateTime   @default(now())
  resolved  Boolean    @default(false)

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory_alerts")
}

model Sale {
  id    String   @id @default(cuid())
  date  DateTime @default(now())
  total Decimal  @db.Decimal(10, 2)
  status SaleStatus @default(paid)
  paymentMethod PaymentMethod?
  notes String?

  // Relations
  items SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SaleItem {
  id       String @id @default(cuid())
  saleId   String
  productId String
  quantity Int
  price    Decimal @db.Decimal(10, 2) // Price at time of sale

  // Relations
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("sale_items")
}

enum Location {
  camara_fria
  casa
  ponto_venda
}

enum MovementType {
  transfer
  sale
  adjustment
  entry
}

enum AlertType {
  low_stock
  out_of_stock
  over_stock
}

enum PaymentMethod {
  cash
  pix
  debit
  credit
  tab
}

enum SaleStatus {
  pending
  paid
  preparing
  delivered
  cancelled
}