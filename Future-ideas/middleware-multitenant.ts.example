// Middleware de Tenant para Next.js
// middleware.ts (VERSÃO MULTI-TENANT)

import { NextResponse } from 'next/server'
import type { NextRequest } from 'next/server'

/**
 * Middleware que detecta o tenant e reescreve a URL
 */
export function middleware(request: NextRequest) {
  const hostname = request.headers.get('host') || ''
  const pathname = request.nextUrl.pathname
  
  // Ignorar arquivos estáticos e API routes internas
  if (
    pathname.startsWith('/_next') ||
    pathname.startsWith('/api/_') ||
    pathname.startsWith('/static') ||
    pathname.match(/\.(ico|png|jpg|jpeg|svg|css|js|woff|woff2|ttf|eot)$/)
  ) {
    return NextResponse.next()
  }
  
  // Extrair subdomain
  const subdomain = extractSubdomain(hostname)
  
  // Rotas públicas que não precisam de tenant
  const publicRoutes = [
    '/',
    '/login',
    '/signup',
    '/pricing',
    '/about',
    '/contact',
    '/terms',
    '/privacy',
  ]
  
  // Se é rota pública E não tem subdomain, deixar passar
  if (!subdomain && publicRoutes.some(route => pathname === route || pathname.startsWith(`${route}/`))) {
    return NextResponse.next()
  }
  
  // Se tem subdomain, adicionar à URL como query param
  if (subdomain) {
    const url = request.nextUrl.clone()
    
    // Já tem o parâmetro? Não duplicar
    if (!url.searchParams.has('tenant')) {
      url.searchParams.set('tenant', subdomain)
      
      // Reescrever URL internamente (usuário não vê)
      return NextResponse.rewrite(url)
    }
  }
  
  // Se não tem subdomain e não é rota pública, redirecionar para landing page
  if (!subdomain && !publicRoutes.some(route => pathname.startsWith(route))) {
    return NextResponse.redirect(new URL('/', request.url))
  }
  
  return NextResponse.next()
}

function extractSubdomain(hostname: string): string | null {
  // Remove porta
  const host = hostname.split(':')[0]
  
  // localhost ou IP
  if (host === 'localhost' || /^\d+\.\d+\.\d+\.\d+$/.test(host)) {
    return null
  }
  
  // Domínios base que não são tenants
  const baseDomains = [
    'nitrobeer.app',
    'seudominio.com.br',
    'localhost',
  ]
  
  // Se é exatamente um domínio base, não é tenant
  if (baseDomains.includes(host)) {
    return null
  }
  
  const parts = host.split('.')
  
  // example.com -> sem subdomain
  if (parts.length <= 2) {
    return null
  }
  
  const subdomain = parts[0]
  
  // Ignorar subdomains especiais
  const reservedSubdomains = ['www', 'api', 'admin', 'app', 'mail', 'ftp']
  if (reservedSubdomains.includes(subdomain)) {
    return null
  }
  
  return subdomain
}

// Configurar quais rotas o middleware deve processar
export const config = {
  matcher: [
    /*
     * Match all request paths except:
     * - _next/static (static files)
     * - _next/image (image optimization files)
     * - favicon.ico (favicon file)
     * - public files (public folder)
     */
    '/((?!_next/static|_next/image|favicon.ico|.*\\.(?:svg|png|jpg|jpeg|gif|webp)$).*)',
  ],
}
